{
  "name": "@afixt/apg-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Sample Playwright specs for the patterns in the ARIA Authoring Practices Guide",
  "license": "MIT",
  "author": "AFixt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFixt/apg-playwright.git"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "markdownlint": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "check": "npm run lint && npm run markdownlint"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@playwright/test": "^1.54.0",
    "eslint": "^9.33.0",
    "eslint-plugin-playwright": "^2.2.0",
    "globals": "^16.3.0",
    "markdownlint-cli2": "^0.18.0"
  }
}
