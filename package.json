{
  "name": "@afixt/apg-playwright",
  "version": "0.1.0",
  "private": true,
  "description": "Sample Playwright specs for the patterns in the ARIA Authoring Practices Guide",
  "license": "MIT",
  "author": "AFixt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFixt/apg-playwright.git"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --project=chromium --ui",
    "report": "playwright show-report",
    "lint": "eslint .",
    "knip": "knip",
    "lint:fix": "eslint . --fix",
    "markdownlint": "markdownlint \"**/*.md\" --ignore node_modules --ignore playwright-report --ignore test-results",
    "markdownlint:fix": "markdownlint --fix \"**/*.md\" --ignore node_modules --ignore playwright-report --ignore test-results",
    "check": "npm run lint && npm run knip && npm run format:check && npm run markdownlint",
    "check:all": "npm run check && npm run dupes && npm run license:check && npm run test:scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dupes": "jscpd",
    "license:check": "license-checker-rseidelsohn --onlyAllow 'MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;CC0-1.0;CC-BY-3.0;CC-BY-4.0;Unlicense;Python-2.0;PSF-2.0;WTFPL;BlueOak-1.0.0' --excludePrivatePackages --summary",
    "security:audit": "npm audit --audit-level=high",
    "security:trufflehog": "bash scripts/run-trufflehog.sh",
    "test:scripts": "node --test \"tests/**/*.test.js\"",
    "test:engines": "playwright test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-playwright": "^2.12.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jscpd": "^5.3.3",
    "knip": "^6.39.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "lint-staged": "^16.4.0",
    "markdownlint-cli": "0.49.1",
    "prettier": "^3.9.9"
  },
  "overrides": {
    "smol-toml": "^1.9.0",
    "markdownlint-cli": {
      "js-yaml": "^5.4.1"
    }
  }
}
